---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { SCENARIOS, SCENARIO_LABELS, SCENARIO_BLURBS } from '../lib/scenarios'

const all = await getCollection('articles')
type Article = (typeof all)[number]

function fmt(date: string) {
  const d = new Date(date)
  return Number.isNaN(d.valueOf())
    ? date
    : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
}

function byDateDesc(a: Article, b: Article) {
  return new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
}

function heroOf(article: Article) {
  return article.data.heroImage ?? article.data.heroGallery?.[0]?.src
}

// Group by category, in the canonical scenario order, newest first within each.
const categories = SCENARIOS.map((scenario) => {
  const items = all.filter((a) => a.data.scenario === scenario).sort(byDateDesc)
  return {
    scenario,
    label: SCENARIO_LABELS[scenario],
    blurb: SCENARIO_BLURBS[scenario],
    current: items.filter((a) => a.data.status !== 'archived'),
    archived: items.filter((a) => a.data.status === 'archived'),
    total: items.length,
  }
}).filter((c) => c.total > 0)

const totalActive = all.filter((a) => a.data.status !== 'archived').length
const totalArchived = all.length - totalActive
---

<BaseLayout
  title="Archive"
  description="Every Galing Gear recommendation, grouped by category — with older, archived articles kept here so you can always browse back through them."
>
  <section class="wrap head">
    <p class="eyebrow mono">The full archive</p>
    <h1>Archive</h1>
    <p class="blurb">
      Everything we&apos;ve published, grouped by category. Current picks are marked
      <span class="status-pill mono is-active">Current</span>; older ones we&apos;ve retired from the
      main listings are marked <span class="status-pill mono is-archived">Archived</span> and kept
      here so you can always browse back through them.
    </p>
    <p class="counts mono">
      {totalActive} current &middot; {totalArchived} archived &middot; {categories.length} categories
    </p>
  </section>

  <section class="wrap section">
    {
      categories.length > 0 ? (
        categories.map((cat) => (
          <section class="category" id={cat.scenario}>
            <div class="cat-head">
              <div class="cat-head-main">
                <h2 class="cat-title">
                  <a href={`/${cat.scenario}/`}>{cat.label}</a>
                </h2>
                <p class="cat-blurb">{cat.blurb}</p>
              </div>
              <p class="cat-counts mono">
                {cat.current.length} current{cat.archived.length > 0 ? ` · ${cat.archived.length} archived` : ''}
              </p>
            </div>

            {cat.current.length > 0 && (
              <ul class="current-list" role="list">
                {cat.current.map((article) => (
                  <li class="current-entry">
                    <time class="date mono" datetime={article.data.publishedAt}>
                      {fmt(article.data.publishedAt)}
                    </time>
                    <a class="current-title" href={`/articles/${article.id}/`}>
                      {article.data.title}
                    </a>
                    <span class="status-pill mono is-active">Current</span>
                  </li>
                ))}
              </ul>
            )}

            {cat.archived.length > 0 && (
              <div class="archived-block">
                <p class="archived-heading mono">
                  <span class="status-pill mono is-archived">Archived</span>
                  Older {cat.label} articles, kept for reference
                </p>
                <div class="archived-grid">
                  {cat.archived.map((article) => (
                    <ArticleCard
                      title={article.data.title}
                      description={article.data.description}
                      scenario={article.data.scenario}
                      publishedAt={article.data.publishedAt}
                      slug={article.id}
                      heroImage={heroOf(article)}
                      status="archived"
                    />
                  ))}
                </div>
              </div>
            )}
          </section>
        ))
      ) : (
        <p class="empty">Nothing published yet. Check back soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-3xl) var(--space-md);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-block-end: var(--space-sm);
  }

  .head h1 {
    font-size: var(--text-display);
  }

  .blurb {
    margin-block-start: var(--space-md);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.4;
  }

  .counts {
    margin-block-start: var(--space-md);
    font-size: var(--text-label);
    color: var(--muted-text);
  }

  .section {
    padding-block: var(--space-lg) var(--space-3xl);
  }

  .category + .category {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-2xl);
    border-block-start: 1px solid var(--hairline);
  }

  .cat-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: baseline;
    justify-content: space-between;
  }

  .cat-head-main {
    max-inline-size: var(--measure);
  }

  .cat-title {
    font-size: var(--text-h1);
  }

  .cat-title a {
    color: var(--main-text);
    text-decoration: none;
  }

  .cat-title a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .cat-blurb {
    margin-block-start: var(--space-2xs);
    color: var(--muted-text);
  }

  .cat-counts {
    font-size: var(--text-label);
    color: var(--muted-text);
    white-space: nowrap;
  }

  .current-list {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-lg);
  }

  .current-entry {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: var(--space-md);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-block-end: 1px solid var(--hairline);
  }

  .current-entry:last-child {
    border-block-end: none;
  }

  .date {
    font-size: var(--text-label);
    color: var(--muted-text);
    white-space: nowrap;
  }

  .current-title {
    font-size: var(--text-h2);
    line-height: 1.2;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--main-text);
    text-decoration: none;
  }

  .current-title:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .archived-block {
    margin-block-start: var(--space-xl);
  }

  .archived-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-label);
    color: var(--muted-text);
    margin-block-end: var(--space-md);
  }

  .archived-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .status-pill {
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 var(--space-xs);
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    line-height: 1.6;
  }

  .status-pill.is-active {
    color: var(--status-success);
  }

  .status-pill.is-archived {
    color: var(--status-caution);
  }

  .empty {
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
  }

  @media (max-width: 40rem) {
    .current-entry {
      grid-template-columns: 1fr auto;
    }

    .current-entry .date {
      grid-column: 1 / -1;
    }
  }
</style>
