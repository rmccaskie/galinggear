---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import { SCENARIO_LABELS } from '../../lib/scenarios'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return articles.map((article) => ({
    params: { slug: article.id },
    props: {
      article,
      related: articles
        .filter((a) => a.data.scenario === article.data.scenario && a.id !== article.id)
        .sort(
          (a, b) =>
            new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
        )
        .slice(0, 3),
    },
  }))
}

interface Props {
  article: CollectionEntry<'articles'>
  related: CollectionEntry<'articles'>[]
}

const { article, related } = Astro.props
const { Content } = await render(article)
const { title, description, scenario, publishedAt, updatedAt, editorNote } = article.data

function fmt(date: string) {
  const d = new Date(date)
  return Number.isNaN(d.valueOf())
    ? date
    : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
}
---

<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="wrap art-head">
      <a class="scenario mono" href={`/${scenario}/`}>{SCENARIO_LABELS[scenario]}</a>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <div class="dates mono">
        <time datetime={publishedAt}>Published {fmt(publishedAt)}</time>
        {updatedAt && <time datetime={updatedAt}>Updated {fmt(updatedAt)}</time>}
      </div>
      {editorNote && <p class="editor-note">{editorNote}</p>}
    </header>

    <div class="wrap">
      <div class="prose body">
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="wrap section">
        <h2 class="section-title">More in {SCENARIO_LABELS[scenario]}</h2>
        <div class="grid">
          {related.map((a) => (
            <ArticleCard
              title={a.data.title}
              description={a.data.description}
              scenario={a.data.scenario}
              publishedAt={a.data.publishedAt}
              slug={a.id}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .art-head {
    padding-block: var(--space-3xl) var(--space-lg);
  }

  .scenario {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-text);
    text-decoration: none;
    margin-block-end: var(--space-md);
  }

  .art-head h1 {
    font-size: var(--text-display);
    max-inline-size: var(--measure);
    text-wrap: balance;
  }

  .description {
    margin-block-start: var(--space-md);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.4;
  }

  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-block-start: var(--space-lg);
    font-size: var(--text-label);
    color: var(--muted-text);
  }

  .editor-note {
    margin-block-start: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border-inline-start: 3px solid var(--accent-text);
    background-color: var(--surface-sunken);
    border-radius: var(--radius-md);
    color: var(--muted-text);
    max-inline-size: var(--measure);
    font-size: var(--text-label);
  }

  .body {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .section {
    padding-block: var(--space-xl);
  }

  .section-title {
    margin-block-end: var(--space-lg);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>

<style is:global>
  .body h2 {
    font-size: var(--text-h1);
    margin-block: var(--space-2xl) var(--space-sm);
    text-wrap: balance;
  }

  .body h3 {
    font-size: var(--text-h2);
    margin-block: var(--space-xl) var(--space-sm);
    text-wrap: balance;
  }

  .body p {
    margin-block-end: var(--space-md);
    line-height: 1.7;
  }

  .body ul,
  .body ol {
    margin-block-end: var(--space-md);
    padding-inline-start: var(--space-lg);
  }

  .body li {
    margin-block-end: var(--space-2xs);
  }

  .body strong {
    color: var(--main-text);
  }

  .body a {
    color: var(--accent-text);
  }
</style>
