---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ScenarioNav from '../components/ScenarioNav.astro'
import ArticleCard from '../components/ArticleCard.astro'
import SubscribeForm from '../components/SubscribeForm.astro'
import featuredOrder from '../data/featured.json'
import { type Locale, DEFAULT_LOCALE } from '../lib/i18n'
import { resolvedCatalogue } from '../lib/catalogue'

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale
const strings = resolvedCatalogue(locale)

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status !== 'archived')
  .sort(
    (a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
  )

// Featured articles — single source of truth: featured.json controls both
// membership and display order. The per-article `featured` frontmatter flag
// is no longer consulted here.
const bySlug = new Map(articles.map((a) => [a.id, a]))
const featuredArticles = (featuredOrder as string[])
  .map((slug) => bySlug.get(slug))
  .filter((a): a is NonNullable<typeof a> => a != null)

const featured = featuredArticles[0] ?? articles[0]
const alsoFeatured = featuredArticles.slice(1)
const featuredIds = new Set(featuredArticles.map((a) => a.id))
const recent = articles
  .filter((a) => a.id !== featured?.id && !featuredIds.has(a.id))
  .slice(0, 6)
---

<BaseLayout
  title={strings['brand.name']}
  description="Preparedness and gear for Filipino families. Practical guides for typhoons, floods, earthquakes and brownouts — plus the gear, bags and gadgets that make the difference."
  locale={locale}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow mono">{strings['home.eyebrow']}</p>
      <h1>{strings['home.h1']}</h1>
      <p class="lede">{strings['home.lede']}</p>
      <a class="btn btn-primary" href="/subscribe/">{strings['home.cta']}</a>
    </div>
  </section>

  <section class="wrap section">
    <ScenarioNav strings={strings} />
  </section>

  {
    featured && (
      <section class="wrap section">
        <h2 class="section-title">{strings['home.editors_pick']}</h2>
        <ArticleCard
          title={featured.data.title}
          description={featured.data.description}
          scenario={featured.data.scenario}
          publishedAt={featured.data.publishedAt}
          slug={featured.id}
          heroImage={featured.data.heroImage ?? featured.data.heroGallery?.[0]?.src}
          articleType={featured.data.articleType}
          featured
        />
      </section>
    )
  }

  {
    alsoFeatured.length > 0 && (
      <section class="wrap section">
        <h2 class="section-title">{strings['home.also_featured']}</h2>
        <div class="grid">
          {alsoFeatured.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              scenario={article.data.scenario}
              publishedAt={article.data.publishedAt}
              slug={article.id}
              heroImage={article.data.heroImage ?? article.data.heroGallery?.[0]?.src}
              articleType={article.data.articleType}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <h2 class="section-title">{strings['home.latest']}</h2>
    {
      recent.length > 0 ? (
        <div class="grid">
          {recent.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              scenario={article.data.scenario}
              publishedAt={article.data.publishedAt}
              slug={article.id}
              heroImage={article.data.heroImage ?? article.data.heroGallery?.[0]?.src}
              articleType={article.data.articleType}
            />
          ))}
        </div>
      ) : (
        <p class="empty">{strings['home.empty']}</p>
      )
    }
  </section>

  <section class="wrap section callout">
    <div class="callout-inner">
      <h2>{strings['home.callout_h2']}</h2>
      <p>{strings['home.callout_body']}</p>
      <SubscribeForm idPrefix="home" locale={locale} strings={strings} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-block-end: var(--space-sm);
  }

  .hero h1 {
    font-size: var(--text-display);
    max-inline-size: 18ch;
  }

  .lede {
    margin-block: var(--space-lg);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    line-height: 1.4;
    font-family: var(--font-display);
    font-weight: 400;
  }

  .section {
    padding-block: var(--space-xl);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-block-end: var(--space-lg);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .empty {
    color: var(--muted-text);
  }

  .callout {
    padding-block: var(--space-3xl);
  }

  .callout-inner {
    background-color: var(--surface-sunken);
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    padding: var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }

  .callout-inner h2 {
    font-size: var(--text-h1);
  }

  .callout-inner p {
    color: var(--muted-text);
    max-inline-size: var(--measure);
  }
</style>
