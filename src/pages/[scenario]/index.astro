---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ScenarioNav from '../../components/ScenarioNav.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import { SCENARIOS, scenarioLabel, scenarioBlurb } from '../../lib/scenarios'
import type { Scenario } from '../../lib/scenarios'
import { type Locale, DEFAULT_LOCALE } from '../../lib/i18n'
import { resolvedCatalogue, fmt, plural } from '../../lib/catalogue'
import { getTaglishMap, localiseArticleData } from '../../lib/article-locale'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return SCENARIOS.map((scenario) => ({
    params: { scenario },
    props: {
      scenario,
      articles: articles
        .filter((a) => a.data.scenario === scenario && a.data.status !== 'archived')
        .sort(
          (a, b) =>
            new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
        ),
      archivedCount: articles.filter(
        (a) => a.data.scenario === scenario && a.data.status === 'archived'
      ).length,
    },
  }))
}

interface Props {
  scenario: Scenario
  articles: Awaited<ReturnType<typeof getCollection<'articles'>>>
  archivedCount: number
}

const { scenario, articles, archivedCount } = Astro.props
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale
const label = scenarioLabel(scenario, locale)
const blurb = scenarioBlurb(scenario, locale)
const strings = resolvedCatalogue(locale)
const tlMap = await getTaglishMap()
---

<BaseLayout title={label} description={`${label}: ${blurb}`} locale={locale}>
  <section class="wrap head">
    <p class="eyebrow mono">{strings['scenario.eyebrow']}</p>
    <h1>{label}</h1>
    <p class="blurb">{blurb}</p>
  </section>

  <section class="wrap section">
    <ScenarioNav active={scenario} locale={locale} strings={strings} />
  </section>

  <section class="wrap section">
    {
      articles.length > 0 ? (
        <div class="grid">
          {articles.map((a) => {
            const d = localiseArticleData(a, locale, tlMap)
            return (
              <ArticleCard
                title={d.title}
                description={d.description}
                scenario={d.scenario}
                publishedAt={d.publishedAt}
                slug={a.id}
                heroImage={d.heroImage ?? d.heroGallery?.[0]?.src}
                articleType={d.articleType}
                featured={d.featured}
                locale={locale}
              />
            )
          })}
        </div>
      ) : (
        <p class="empty">{strings['scenario.empty']}</p>
      )
    }
  </section>

  {
    archivedCount > 0 && (
      <section class="wrap section archive-cta">
        <a class="archive-link" href={`/archive#cat-${scenario}`}>
          {fmt(strings, 'scenario.archive_link', { label })}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <p class="archive-note">
          {fmt(strings, 'scenario.archive_note', {
            count: String(archivedCount),
            countNoun: plural(strings, 'article', archivedCount),
          })}
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-3xl) var(--space-md);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-block-end: var(--space-sm);
  }

  .head h1 {
    font-size: var(--text-display);
  }

  .blurb {
    margin-block-start: var(--space-md);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.4;
  }

  .section {
    padding-block: var(--space-lg);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .empty {
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
  }

  .archive-cta {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--hairline);
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h2);
    color: var(--accent-text);
    text-decoration: none;
  }

  .archive-link:hover {
    text-decoration: underline;
  }

  .archive-link span {
    transition: transform 0.15s ease;
  }

  .archive-link:hover span {
    transform: translateX(0.2rem);
  }

  .archive-note {
    margin-block-start: var(--space-2xs);
    color: var(--muted-text);
    font-size: var(--text-label);
  }
</style>
