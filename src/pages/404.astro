---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ScenarioNav from '../components/ScenarioNav.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { type Locale, DEFAULT_LOCALE } from '../lib/i18n'
import { resolvedCatalogue } from '../lib/catalogue'
import { getTaglishMap, localiseArticleData } from '../lib/article-locale'

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale
const strings = resolvedCatalogue(locale)
const tlMap = await getTaglishMap()

const articles = (await getCollection('articles'))
  .filter((a) => a.data.status !== 'archived')
  .sort(
    (a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
  )

const recent = articles.slice(0, 3)
---

<BaseLayout
  title={strings['404.h1']}
  description={strings['404.blurb']}
  locale={locale}
>
  <section class="wrap head">
    <p class="eyebrow mono">{strings['404.eyebrow']}</p>
    <h1>{strings['404.h1']}</h1>
    <p class="blurb">{strings['404.blurb']}</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">{strings['404.back_home']}</a>
      <a class="btn btn-ghost" href="/archive/">{strings['404.browse_archive']}</a>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title">{strings['404.browse_by_category']}</h2>
    <ScenarioNav strings={strings} />
  </section>

  {
    recent.length > 0 && (
      <section class="wrap section">
        <h2 class="section-title">{strings['404.latest']}</h2>
        <div class="grid">
          {recent.map((a) => {
            const d = localiseArticleData(a, locale, tlMap)
            return (
              <ArticleCard
                title={d.title}
                description={d.description}
                scenario={d.scenario}
                publishedAt={d.publishedAt}
                slug={a.id}
                heroImage={d.heroImage ?? d.heroGallery?.[0]?.src}
                articleType={d.articleType}
              />
            )
          })}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-block-end: var(--space-sm);
  }

  .head h1 {
    font-size: var(--text-display);
    max-inline-size: 18ch;
  }

  .blurb {
    margin-block: var(--space-lg);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    line-height: 1.4;
    font-family: var(--font-display);
    font-weight: 400;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .section {
    padding-block: var(--space-xl);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-block-end: var(--space-lg);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
