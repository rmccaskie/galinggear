---
import BaseLayout from '../layouts/BaseLayout.astro'
import SubscribeForm from '../components/SubscribeForm.astro'
import { messageForCode, SUBSCRIBE_COPY } from '../lib/strings'

// Server-rendered so the no-JS redirect from /api/subscribe can show its
// confirmation or error message without any client script. See docs/DECISIONS.md.
export const prerender = false

const status = Astro.url.searchParams.get('status')
const code = Astro.url.searchParams.get('code')

let banner: { state: 'success' | 'error'; message: string } | null = null
if (status === 'success') {
  banner = { state: 'success', message: SUBSCRIBE_COPY.success }
} else if (status === 'error' && code) {
  banner = { state: 'error', message: messageForCode(code) }
}
---

<BaseLayout
  title="Subscribe"
  description="Join the Galing Gear list: preparedness guides and the gear that makes the difference for Filipino families — often and regular."
>
  <section class="wrap subscribe-page">
    <p class="eyebrow mono">Join the list</p>
    <h1>Guides, gear and gadgets</h1>
    <p class="lede">
      Typhoons, floods, earthquakes and brownouts — we write up how to get your family ready, and
      the gear, bags and gadgets that make the difference. No spam, unsubscribe any time.
    </p>

    {
      banner && (
        <p class={`banner banner-${banner.state}`} role="status" aria-live="polite">
          {banner.message}
        </p>
      )
    }

    <SubscribeForm idPrefix="page" />
  </section>
</BaseLayout>

<style>
  .subscribe-page {
    padding-block: var(--space-3xl) var(--space-4xl);
    display: grid;
    gap: var(--space-md);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
  }

  .subscribe-page h1 {
    font-size: var(--text-display);
    max-inline-size: 16ch;
  }

  .lede {
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.4;
    margin-block-end: var(--space-md);
  }

  .banner {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--hairline);
    max-inline-size: 30rem;
  }

  .banner-success {
    color: var(--status-success);
    border-color: var(--status-success);
  }

  .banner-error {
    color: var(--status-error);
    border-color: var(--status-error);
  }
</style>
