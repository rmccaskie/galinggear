---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import scenarioOrder from '../../../data/scenario-order.json'
import ArticleCard from '../../../components/ArticleCard.astro'
import { SCENARIOS, scenarioLabel, scenarioBlurb } from '../../../lib/scenarios'
import type { Scenario } from '../../../lib/scenarios'
import { type Locale, DEFAULT_LOCALE, localisedPath } from '../../../lib/i18n'
import { resolvedCatalogue, fmt, plural } from '../../../lib/catalogue'
import { getTaglishMap, localiseArticleData } from '../../../lib/article-locale'

export async function getStaticPaths() {
  const articles = await getCollection('articles')
  return SCENARIOS.map((scenario) => ({
    params: { scenario },
    props: {
      scenario,
      articles: (() => {
        const order = (scenarioOrder as Record<string, string[]>)[scenario] ?? []
        const rank = new Map(order.map((slug, i) => [slug, i]))
        return articles
          .filter((a) => a.data.scenario === scenario && a.data.status !== 'archived')
          .sort((a, b) => {
            const ra = rank.has(a.id) ? rank.get(a.id)! : Infinity
            const rb = rank.has(b.id) ? rank.get(b.id)! : Infinity
            if (ra !== rb) return ra - rb
            return (
              new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
            )
          })
      })(),
      archivedCount: articles.filter(
        (a) => a.data.scenario === scenario && a.data.status === 'archived'
      ).length,
    },
  }))
}

interface Props {
  scenario: Scenario
  articles: Awaited<ReturnType<typeof getCollection<'articles'>>>
  archivedCount: number
}

const { scenario, articles, archivedCount } = Astro.props
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale
const label = scenarioLabel(scenario, locale)
const blurb = scenarioBlurb(scenario, locale)
const strings = resolvedCatalogue(locale)
const tlMap = await getTaglishMap()

// Layout mirrors the homepage: two lead heroes (the two NEWEST articles by
// publish date) shown side by side, then everything else flows into a dense,
// paginated 5-across grid. When a scenario has fewer than three articles there
// aren't enough to justify the split, so we fall back to a plain uniform grid.
const USE_HEROES = articles.length >= 3
const heroes = USE_HEROES
  ? [...articles]
      .sort(
        (a, b) =>
          new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf()
      )
      .slice(0, 2)
  : []
const heroIds = new Set(heroes.map((a) => a.id))
// The remainder keeps the scenario's canonical order (admin drag order, then
// date), minus the two articles promoted to heroes.
const rest = USE_HEROES ? articles.filter((a) => !heroIds.has(a.id)) : []
---

<BaseLayout title={label} description={`${label}: ${blurb}`} locale={locale}>
  <section class="wrap head">
    <p class="eyebrow mono">{strings['scenario.eyebrow']}</p>
    <h1>{label}</h1>
    <p class="blurb">{blurb}</p>
  </section>

  {
    articles.length === 0 && (
      <section class="wrap section">
        <p class="empty">{strings['scenario.empty']}</p>
      </section>
    )
  }

  {
    !USE_HEROES && articles.length > 0 && (
      <section class="wrap section">
        <div class="grid">
          {articles.map((a) => {
            const d = localiseArticleData(a, locale, tlMap)
            return (
              <ArticleCard
                title={d.title}
                description={d.description}
                scenario={d.scenario}
                publishedAt={d.publishedAt}
                slug={a.id}
                heroImage={d.heroImage ?? d.heroGallery?.[0]?.src}
                articleType={d.articleType}
                social={d.social}
                featured={d.featured}
                locale={locale}
              />
            )
          })}
        </div>
      </section>
    )
  }

  {
    USE_HEROES && (
      <section class="wrap section">
        <div class="editors-grid">
          {heroes.map((a) => {
            const d = localiseArticleData(a, locale, tlMap)
            return (
              <ArticleCard
                title={d.title}
                description={d.description}
                scenario={d.scenario}
                publishedAt={d.publishedAt}
                slug={a.id}
                heroImage={d.heroImage ?? d.heroGallery?.[0]?.src}
                articleType={d.articleType}
                social={d.social}
                featured
                locale={locale}
              />
            )
          })}
        </div>
      </section>
    )
  }

  {
    USE_HEROES && rest.length > 0 && (
      <section class="wrap section latest" data-latest>
        <h2 class="section-title">{fmt(strings, 'scenario.more', { label })}</h2>
        <div class="grid latest-grid" data-latest-grid>
          {rest.map((a) => {
            const d = localiseArticleData(a, locale, tlMap)
            return (
              <ArticleCard
                title={d.title}
                description={d.description}
                scenario={d.scenario}
                publishedAt={d.publishedAt}
                slug={a.id}
                heroImage={d.heroImage ?? d.heroGallery?.[0]?.src}
                articleType={d.articleType}
                social={d.social}
                locale={locale}
              />
            )
          })}
        </div>

        <div class="latest-loadmore" data-loadmore hidden>
          <button type="button" class="btn btn-ghost" data-loadmore-btn>
            {strings['home.load_more']}
          </button>
        </div>

        <nav class="latest-pager" data-pager aria-label={strings['home.pagination']} hidden>
          <button type="button" class="pager-arrow" data-pager-prev>
            {'\u2039 ' + strings['home.prev']}
          </button>
          <div class="pager-nums" data-pager-nums />
          <button type="button" class="pager-arrow" data-pager-next>
            {strings['home.next'] + ' \u203a'}
          </button>
        </nav>
      </section>
    )
  }

  {
    archivedCount > 0 && (
      <section class="wrap section archive-cta">
        <a class="archive-link" href={localisedPath(locale, `/archive#cat-${scenario}`)}>
          {fmt(strings, 'scenario.archive_link', { label })}
          <span aria-hidden="true">&rarr;</span>
        </a>
        <p class="archive-note">
          {fmt(strings, 'scenario.archive_note', {
            count: String(archivedCount),
            countNoun: plural(strings, 'article', archivedCount),
          })}
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-3xl) var(--space-md);
  }

  .eyebrow {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-text);
    margin-block-end: var(--space-sm);
  }

  .head h1 {
    font-size: var(--text-display);
  }

  .blurb {
    margin-block-start: var(--space-md);
    max-inline-size: var(--measure);
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.4;
  }

  .section {
    padding-block: var(--space-lg);
  }

  .section-title {
    font-size: var(--text-h2);
    margin-block-end: var(--space-lg);
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  /* ---- Lead heroes: two newest side by side ---- */
  .editors-grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(2, 1fr);
    align-items: stretch;
  }

  /* Scale the hero title down a touch so both cards stay balanced in their
     half-width columns. */
  .editors-grid :global(.card.featured .title) {
    font-size: var(--text-h2);
  }

  /* ---- More in scenario: dense 5-across grid with paging ---- */
  .latest-grid {
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem 1.1rem;
  }

  .latest-grid :global(.card[hidden]) {
    display: none;
  }

  .latest-grid :global(.card .title) {
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .latest-grid :global(.card .description) {
    font-size: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .latest-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 760px) {
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .latest-grid {
      grid-template-columns: 1fr;
    }
  }

  /* On narrow screens the heroes and the More list both collapse into vertical
     stacks — add a clear separator between them. */
  @media (max-width: 48rem) {
    .latest {
      border-block-start: 1px solid var(--hairline);
      margin-block-start: var(--space-md);
      padding-block-start: var(--space-xl);
    }
  }

  /* ---- Paging controls ---- */
  .latest-pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-block-start: var(--space-2xl);
    flex-wrap: wrap;
  }

  .latest-pager[hidden] {
    display: none;
  }

  .pager-nums {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  :global(.pager-num) {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--hairline);
    background: var(--surface);
    color: var(--main-text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    cursor: pointer;
  }

  :global(.pager-num.is-active) {
    background: var(--teal-800);
    color: #fff;
    border-color: var(--teal-800);
  }

  .pager-arrow {
    border: 1px solid var(--hairline);
    background: var(--surface);
    color: var(--main-text);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
  }

  .pager-arrow:hover:not(:disabled),
  :global(.pager-num:hover) {
    border-color: var(--teal-800);
  }

  .pager-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .latest-loadmore {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-xl);
  }

  .latest-loadmore[hidden] {
    display: none;
  }

  .empty {
    color: var(--muted-text);
    font-size: var(--text-h2);
    font-family: var(--font-display);
  }

  .archive-cta {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-xl);
    border-block-start: 1px solid var(--hairline);
  }

  .archive-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h2);
    color: var(--accent-text);
    text-decoration: none;
  }

  .archive-link:hover {
    text-decoration: underline;
  }

  .archive-link span {
    transition: transform 0.15s ease;
  }

  .archive-link:hover span {
    transform: translateX(0.2rem);
  }

  .archive-note {
    margin-block-start: var(--space-2xs);
    color: var(--muted-text);
    font-size: var(--text-label);
  }
</style>

<script>
  const root = document.querySelector('[data-latest]')
  if (root) {
    const grid = root.querySelector('[data-latest-grid]')
    const cards = grid ? Array.from(grid.querySelectorAll(':scope > .card')) : []
    const heading = root.querySelector('.section-title')

    const loadmoreWrap = root.querySelector('[data-loadmore]')
    const loadmoreBtn = root.querySelector('[data-loadmore-btn]')

    const pager = root.querySelector('[data-pager]')
    const pagerPrev = root.querySelector('[data-pager-prev]')
    const pagerNext = root.querySelector('[data-pager-next]')
    const pagerNums = root.querySelector('[data-pager-nums]')

    const PER = 5
    const total = cards.length
    const pageCount = Math.max(1, Math.ceil(total / PER))
    const mq = window.matchMedia('(max-width: 48rem)')

    let currentPage = 1
    let shown = Math.min(PER, total)

    function showRange(start, end) {
      cards.forEach((card, i) => {
        card.hidden = i < start || i >= end
      })
    }

    function renderPager() {
      if (!pagerNums) return
      pagerNums.innerHTML = ''
      for (let p = 1; p <= pageCount; p += 1) {
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'pager-num' + (p === currentPage ? ' is-active' : '')
        btn.textContent = String(p)
        if (p === currentPage) btn.setAttribute('aria-current', 'page')
        btn.addEventListener('click', () => {
          currentPage = p
          applyDesktop(true)
        })
        pagerNums.appendChild(btn)
      }
      if (pagerPrev) pagerPrev.disabled = currentPage <= 1
      if (pagerNext) pagerNext.disabled = currentPage >= pageCount
    }

    function applyDesktop(scroll) {
      const start = (currentPage - 1) * PER
      showRange(start, start + PER)
      renderPager()
      if (scroll && heading) heading.scrollIntoView({ behavior: 'smooth', block: 'start' })
    }

    function applyMobile() {
      showRange(0, shown)
      if (loadmoreBtn) loadmoreBtn.hidden = shown >= total
    }

    function apply() {
      if (mq.matches) {
        if (pager) pager.hidden = true
        if (loadmoreWrap) loadmoreWrap.hidden = false
        applyMobile()
      } else {
        if (loadmoreWrap) loadmoreWrap.hidden = true
        if (pager) pager.hidden = pageCount <= 1
        applyDesktop(false)
      }
    }

    if (loadmoreBtn) {
      loadmoreBtn.addEventListener('click', () => {
        shown = Math.min(shown + PER, total)
        applyMobile()
      })
    }
    if (pagerPrev) {
      pagerPrev.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage -= 1
          applyDesktop(true)
        }
      })
    }
    if (pagerNext) {
      pagerNext.addEventListener('click', () => {
        if (currentPage < pageCount) {
          currentPage += 1
          applyDesktop(true)
        }
      })
    }

    const onChange = () => {
      currentPage = 1
      shown = Math.min(PER, total)
      apply()
    }
    if (mq.addEventListener) mq.addEventListener('change', onChange)
    else mq.addListener(onChange)

    apply()
  }
</script>
