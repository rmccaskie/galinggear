---
import '../styles/global.css'
import SEO from '../components/SEO.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Lightbox from '../components/Lightbox.astro'
import VideoLightbox from '../components/VideoLightbox.astro'
import { type Locale, DEFAULT_LOCALE, HTML_LANG, URL_PREFIX } from '../lib/i18n'
import { resolvedCatalogue, type CatalogueKey } from '../lib/catalogue'

interface Props {
  title: string
  description: string
  image?: string
  type?: 'website' | 'article'
  locale?: Locale
}

const locale: Locale = (Astro.props.locale ?? Astro.currentLocale ?? DEFAULT_LOCALE) as Locale
const { title, description, image, type } = Astro.props
const strings = resolvedCatalogue(locale)
const htmlLang = HTML_LANG[locale]

// Strip the locale prefix from the current URL to get the bare path
// (used by the language switcher to build the equivalent URL in each locale).
const rawPath = Astro.url.pathname
const prefix = URL_PREFIX[locale]
const barePath = prefix && rawPath.startsWith(prefix) ? rawPath.slice(prefix.length) || '/' : rawPath
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0F5C63" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply theme before paint to avoid a flash. -->
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('gg-theme')
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
          const theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          /* no-op */
        }
      })()
    </script>

    <SEO title={title} description={description} image={image} type={type} locale={locale} />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings['nav.skip_to_content']}</a>
    <Header locale={locale} strings={strings} currentPath={barePath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} strings={strings} />
    <Lightbox />
    <VideoLightbox />
  </body>
</html>
