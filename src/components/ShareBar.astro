---
/**
 * ShareBar — per-article share + copy-post widget.
 *
 * Baked, RLS-safe: the social copy and nominated share image are written into
 * the article frontmatter by the admin at publish / nominate time, so this is
 * a purely static component (no client fetch, no Supabase read).
 *
 * Share buttons:
 *   - Facebook / LinkedIn: carry the article URL only. Both platforms scrape
 *     the page's Open Graph tags, so the nominated share image (set as the
 *     page's og:image) is what appears in the preview.
 *   - X: opens the composer pre-filled with our X copy + the URL.
 *   - Instagram: no web share intent exists — copy the caption instead.
 *
 * Copy buttons: every platform with baked copy gets a “copy post text” button
 * (Facebook's copies the text + URL, for pasting into a comment).
 *
 * Locale: on Taglish pages the *Tl copy is used (falling back to the base
 * English copy); on English pages the base copy is used.
 */
import { type Locale } from '../lib/i18n'

interface SocialCopy {
  facebook?: string
  x?: string
  linkedin?: string
  instagram?: string
  facebookTl?: string
  xTl?: string
  linkedinTl?: string
  instagramTl?: string
}

interface Props {
  /** Absolute URL of the article being shared. */
  url: string
  social?: SocialCopy
  locale?: Locale
  variant?: 'compact' | 'full'
  /** Heading shown above the full variant. */
  heading?: string
}

const { url, social, locale = 'en', variant = 'full', heading = 'Share this' } = Astro.props

const isTaglish = locale !== 'en'
const pick = (base?: string, tl?: string) => ((isTaglish ? tl || base : base) || '').trim()

const fb = pick(social?.facebook, social?.facebookTl)
const x = pick(social?.x, social?.xTl)
const li = pick(social?.linkedin, social?.linkedinTl)
const ig = pick(social?.instagram, social?.instagramTl)

const enc = encodeURIComponent
const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`
const liShare = `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`
const xShare = `https://twitter.com/intent/tweet?${x ? `text=${enc(x)}&` : ''}url=${enc(url)}`

// Facebook comments can't carry a link card, so its copy includes the URL.
const fbCopy = fb ? `${fb}\n\n${url}` : ''
const compact = variant === 'compact'
---

<div class:list={['sharebar', { compact }]}>
  {!compact && <p class="sharebar__heading mono">{heading}</p>}

  <div class="sharebar__row">
    {/* Facebook */}
    <div class="sharebar__group">
      <a
        class="sb-btn sb-fb"
        href={fbShare}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on Facebook"
        title="Share on Facebook"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.09 5.66 21.25 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47H15.2c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22C18.34 21.25 22 17.09 22 12.06Z"/></svg>
        {!compact && <span>Share</span>}
      </a>
      {fbCopy && (
        <button type="button" class="sb-btn sb-copy" data-gg-copy={fbCopy} aria-label="Copy Facebook post text">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-gg-label>{compact ? '' : 'Copy text'}</span>
        </button>
      )}
    </div>

    {/* X */}
    <div class="sharebar__group">
      <a
        class="sb-btn sb-x"
        href={xShare}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on X"
        title="Share on X"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.83L1.24 2.25h6.83l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.01 4.13H5.05l12.03 15.64Z"/></svg>
        {!compact && <span>Share</span>}
      </a>
      {x && (
        <button type="button" class="sb-btn sb-copy" data-gg-copy={x} aria-label="Copy X post text">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-gg-label>{compact ? '' : 'Copy text'}</span>
        </button>
      )}
    </div>

    {/* LinkedIn */}
    <div class="sharebar__group">
      <a
        class="sb-btn sb-li"
        href={liShare}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Share on LinkedIn"
        title="Share on LinkedIn"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        {!compact && <span>Share</span>}
      </a>
      {li && (
        <button type="button" class="sb-btn sb-copy" data-gg-copy={li} aria-label="Copy LinkedIn post text">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span data-gg-label>{compact ? '' : 'Copy text'}</span>
        </button>
      )}
    </div>

    {/* Instagram — copy caption only (no web share intent) */}
    {ig && (
      <div class="sharebar__group">
        <button type="button" class="sb-btn sb-ig" data-gg-copy={ig} aria-label="Copy Instagram caption" title="Copy Instagram caption">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.5.01-4.74.07-.99.05-1.53.21-1.88.35-.47.18-.81.4-1.17.76-.36.36-.58.7-.76 1.17-.14.35-.3.89-.35 1.88-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.05.99.21 1.53.35 1.88.18.47.4.81.76 1.17.36.36.7.58 1.17.76.35.14.89.3 1.88.35 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.99-.05 1.53-.21 1.88-.35.47-.18.81-.4 1.17-.76.36-.36.58-.7.76-1.17.14-.35.3-.89.35-1.88.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.05-.99-.21-1.53-.35-1.88a3.15 3.15 0 0 0-.76-1.17 3.15 3.15 0 0 0-1.17-.76c-.35-.14-.89-.3-1.88-.35-1.24-.06-1.59-.07-4.74-.07Zm0 2.76a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6Zm0 8.74a3.44 3.44 0 1 0 0-6.88 3.44 3.44 0 0 0 0 6.88Zm6.74-8.94a1.24 1.24 0 1 1-2.48 0 1.24 1.24 0 0 1 2.48 0Z"/></svg>
        {!compact && <span data-gg-label>Copy caption</span>}
      </button>
      </div>
    )}
  </div>
</div>

<script>
  // One delegated listener handles every ShareBar copy button on the page.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement
    const btn = target.closest('[data-gg-copy]') as HTMLButtonElement | null
    if (!btn) return
    const text = btn.getAttribute('data-gg-copy') || ''
    if (!text) return
    navigator.clipboard
      .writeText(text)
      .then(() => {
        const label = btn.querySelector('[data-gg-label]') as HTMLElement | null
        const prev = label ? label.textContent : null
        if (label && label.textContent) label.textContent = 'Copied'
        btn.classList.add('is-copied')
        window.setTimeout(() => {
          if (label && prev !== null) label.textContent = prev
          btn.classList.remove('is-copied')
        }, 1500)
      })
      .catch(() => {})
  })
</script>

<style>
  .sharebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .sharebar__heading {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-text);
    margin: 0;
  }

  .sharebar__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }

  .sharebar__group {
    display: inline-flex;
    align-items: stretch;
    border-radius: var(--radius-pill);
    overflow: hidden;
    border: 1px solid var(--hairline);
  }

  .sb-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1;
    color: var(--main-text);
    background-color: var(--surface);
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .sb-btn:hover {
    background-color: var(--surface-sunken);
  }

  .sb-btn svg {
    flex-shrink: 0;
  }

  /* The share link keeps a subtle right divider from its copy sibling. */
  .sharebar__group .sb-copy {
    border-inline-start: 1px solid var(--hairline);
    color: var(--muted-text);
  }

  .sb-btn.is-copied {
    color: var(--status-success);
  }

  /* Brand colour accents on hover for the share links. */
  .sb-fb:hover { color: #1877f2; }
  .sb-x:hover { color: #000; }
  .sb-li:hover { color: #0a66c2; }
  .sb-ig:hover { color: #c13584; }

  /* Compact variant (article card): icon-only, tighter. */
  .sharebar.compact .sharebar__row {
    gap: var(--space-xs);
  }

  .sharebar.compact .sb-btn {
    padding: var(--space-2xs);
  }
</style>
