---
// YouTube video lightbox. Attaches to any <button class="gg-video-play">
// carrying a data-video-id. Opens the privacy-enhanced YouTube player in an
// overlay; closing clears the iframe src so playback stops.
---

<div
  id="gg-video-lightbox"
  class="gg-video-lightbox"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Video player"
>
  <button class="gg-vlb-close" type="button" aria-label="Close">&times;</button>
  <div class="gg-vlb-frame">
    <iframe
      title="YouTube video player"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</div>

<script is:inline>
  ;(() => {
    const lb = document.getElementById('gg-video-lightbox')
    if (!lb) return
    const frame = lb.querySelector('iframe')
    const btnClose = lb.querySelector('.gg-vlb-close')

    function open(id) {
      if (!id) return
      frame.src =
        'https://www.youtube-nocookie.com/embed/' +
        encodeURIComponent(id) +
        '?autoplay=1&rel=0'
      lb.hidden = false
      document.body.style.overflow = 'hidden'
    }

    function close() {
      lb.hidden = true
      document.body.style.overflow = ''
      // Clearing the src stops playback.
      frame.removeAttribute('src')
    }

    document.addEventListener('click', (e) => {
      const t = e.target
      if (!t || !t.closest) return
      const btn = t.closest('.gg-video-play')
      if (btn) {
        e.preventDefault()
        open(btn.getAttribute('data-video-id'))
      }
    })

    btnClose.addEventListener('click', close)
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close()
    })
    document.addEventListener('keydown', (e) => {
      if (!lb.hidden && e.key === 'Escape') close()
    })
  })()
</script>
