---
import { scenarioLabel } from '../lib/scenarios'
import type { Scenario } from '../lib/scenarios'
import type { CatalogueKey } from '../lib/catalogue'
import { localisedPath, DEFAULT_LOCALE, type Locale } from '../lib/i18n'

interface Props {
  title: string
  description: string
  scenario: Scenario
  publishedAt: string
  slug: string
  featured?: boolean
  heroImage?: string
  status?: 'active' | 'archived'
  articleType?: 'review' | 'guide'
  locale?: Locale
  strings?: Record<CatalogueKey, string>
}

const { title, description, scenario, publishedAt, slug, featured = false, heroImage, status, articleType, locale, strings } = Astro.props
const lp = (p: string) => localisedPath(locale ?? DEFAULT_LOCALE, p)

const readLabel =
  articleType === 'review'
    ? (strings?.['card.read_review'] ?? 'Read the review →')
    : articleType === 'guide'
      ? (strings?.['card.read_guide'] ?? 'Read the guide →')
      : (strings?.['card.read_more'] ?? 'Read more →')

const published = new Date(publishedAt)
const publishedLabel = Number.isNaN(published.valueOf())
  ? publishedAt
  : published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<article class:list={['card', { featured, 'has-thumb': heroImage }]}>
  {
    heroImage && (
      <a class="thumb" href={lp(`/articles/${slug}/`)} aria-hidden="true" tabindex="-1">
        <img src={heroImage} alt="" loading="lazy" />
      </a>
    )
  }
  <div class="meta-row">
    <a class="scenario mono" href={lp(`/${scenario}/`)}>{scenarioLabel(scenario, locale)}</a>
    {status && (
      <span class:list={['status-pill', 'mono', status === 'archived' ? 'is-archived' : 'is-active']}>
        {status === 'archived' ? (strings?.['card.status_archived'] ?? 'Archived') : (strings?.['card.status_current'] ?? 'Current')}
      </span>
    )}
  </div>
  <h3 class="title">
    <a href={lp(`/articles/${slug}/`)}>{title}</a>
  </h3>
  <p class="description">{description}</p>
  <div class="foot">
    <time class="mono" datetime={publishedAt}>{publishedLabel}</time>
    <a class="read" href={lp(`/articles/${slug}/`)}>{readLabel}</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background-color: var(--surface);
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    block-size: 100%;
  }

  .card.has-thumb {
    padding-block-start: 0;
    overflow: hidden;
  }

  .thumb {
    display: block;
    margin-inline: calc(-1 * var(--space-lg));
    margin-block-end: var(--space-xs);
    aspect-ratio: 16 / 9;
    background-color: var(--surface-sunken);
    overflow: hidden;
  }

  .thumb img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Anchor the crop to the top so a hero's headline / top content is never
       clipped (e.g. tall infographics). Only the bottom is trimmed to fit. */
    object-position: top center;
    transition: transform 200ms ease;
  }

  /* Editor's pick / featured: the hero image fills the full-bleed thumb panel
     edge-to-edge, cropped to cover, matching the article-page hero treatment.
     Uses the shared --hero-ratio token so it re-shapes with the heroes. */
  .card.has-thumb.featured {
    padding-block-start: var(--space-lg);
  }

  .card.has-thumb.featured .thumb {
    aspect-ratio: var(--hero-ratio);
    margin-inline: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card.has-thumb.featured .thumb img {
    object-fit: cover;
  }

  .card:hover .thumb img {
    transform: scale(1.03);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .status-pill {
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 var(--space-xs);
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    line-height: 1.6;
  }

  .status-pill.is-active {
    color: var(--status-success);
  }

  .status-pill.is-archived {
    color: var(--status-caution);
  }

  .scenario {
    align-self: start;
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
  }

  .scenario:hover {
    text-decoration: underline;
  }

  .title {
    font-size: var(--text-h2);
    line-height: 1.15;
  }

  .title a {
    color: var(--main-text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent-text);
  }

  .description {
    color: var(--muted-text);
    max-inline-size: var(--measure);
  }

  .foot {
    margin-block-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: baseline;
    justify-content: space-between;
    padding-block-start: var(--space-sm);
  }

  .foot time {
    font-size: var(--text-label);
    color: var(--muted-text);
  }

  .read {
    font-weight: 500;
    text-decoration: none;
  }

  .read:hover {
    text-decoration: underline;
  }

  .featured {
    gap: var(--space-md);
    padding: var(--space-xl);
    border-color: var(--accent-text);
  }

  .featured .title {
    font-size: var(--text-h1);
  }

  @media (max-width: 48rem) {
    .featured {
      grid-column: 1 / -1;
    }
  }
</style>
