---
import { SCENARIO_LABELS } from '../lib/scenarios'
import type { Scenario } from '../lib/scenarios'

interface Props {
  title: string
  description: string
  scenario: Scenario
  publishedAt: string
  slug: string
  featured?: boolean
  heroImage?: string
  status?: 'active' | 'archived'
}

const { title, description, scenario, publishedAt, slug, featured = false, heroImage, status } = Astro.props

const published = new Date(publishedAt)
const publishedLabel = Number.isNaN(published.valueOf())
  ? publishedAt
  : published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<article class:list={['card', { featured, 'has-thumb': heroImage }]}>
  {
    heroImage && (
      <a class="thumb" href={`/articles/${slug}/`} aria-hidden="true" tabindex="-1">
        <img src={heroImage} alt="" loading="lazy" />
      </a>
    )
  }
  <div class="meta-row">
    <a class="scenario mono" href={`/${scenario}/`}>{SCENARIO_LABELS[scenario]}</a>
    {status && (
      <span class:list={['status-pill', 'mono', status === 'archived' ? 'is-archived' : 'is-active']}>
        {status === 'archived' ? 'Archived' : 'Current'}
      </span>
    )}
  </div>
  <h3 class="title">
    <a href={`/articles/${slug}/`}>{title}</a>
  </h3>
  <p class="description">{description}</p>
  <div class="foot">
    <time class="mono" datetime={publishedAt}>{publishedLabel}</time>
    <a class="read" href={`/articles/${slug}/`}>Read the recommendation →</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background-color: var(--surface);
    border: none;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    block-size: 100%;
  }

  .card.has-thumb {
    padding-block-start: 0;
    overflow: hidden;
  }

  .thumb {
    display: block;
    margin-inline: calc(-1 * var(--space-lg));
    margin-block-end: var(--space-xs);
    aspect-ratio: 16 / 9;
    background-color: var(--surface-sunken);
    overflow: hidden;
  }

  .thumb img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  /* Editor's pick: restore top breathing room so the image panel sits inside a
     frame instead of being flush against the top edge of the card. */
  .card.has-thumb.featured {
    padding-block-start: var(--space-xl);
  }

  /* The image sits in a neat, evenly-padded rounded panel: even whitespace all
     round (top and sides), scaled to fit rather than cropped, matching the
     article-page hero treatment. */
  .card.has-thumb.featured .thumb {
    aspect-ratio: 16 / 9;
    max-block-size: 30rem;
    margin-inline: 0;
    padding: var(--space-md);
    border-radius: var(--radius-md);
  }

  .card.has-thumb.featured .thumb img {
    object-fit: contain;
  }

  .card:hover .thumb img {
    transform: scale(1.03);
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .status-pill {
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 var(--space-xs);
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    line-height: 1.6;
  }

  .status-pill.is-active {
    color: var(--status-success);
  }

  .status-pill.is-archived {
    color: var(--status-caution);
  }

  .scenario {
    align-self: start;
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
  }

  .scenario:hover {
    text-decoration: underline;
  }

  .title {
    font-size: var(--text-h2);
    line-height: 1.15;
  }

  .title a {
    color: var(--main-text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent-text);
  }

  .description {
    color: var(--muted-text);
    max-inline-size: var(--measure);
  }

  .foot {
    margin-block-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    align-items: baseline;
    justify-content: space-between;
    padding-block-start: var(--space-sm);
  }

  .foot time {
    font-size: var(--text-label);
    color: var(--muted-text);
  }

  .read {
    font-weight: 500;
    text-decoration: none;
  }

  .read:hover {
    text-decoration: underline;
  }

  .featured {
    gap: var(--space-md);
    padding: var(--space-xl);
    border-color: var(--accent-text);
  }

  .featured .title {
    font-size: var(--text-h1);
  }

  @media (max-width: 48rem) {
    .featured {
      grid-column: 1 / -1;
    }
  }
</style>
