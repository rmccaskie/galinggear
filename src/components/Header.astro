---
import { getCollection } from 'astro:content'
import { scenarioLabel, getNavScenarios } from '../lib/scenarios'
import { localisedPath, type Locale } from '../lib/i18n'
import type { CatalogueKey } from '../lib/catalogue'
import LocaleSwitcher from './LocaleSwitcher.astro'

interface Props {
  locale: Locale
  strings: Readonly<Record<CatalogueKey, string>>
  /** Bare path (no locale prefix) for the switcher, e.g. '/' or '/subscribe/' */
  currentPath?: string
}

const { locale, strings, currentPath = '/' } = Astro.props
// Localise internal links so the active locale (e.g. /en) sticks across navigation.
const lp = (p: string) => localisedPath(locale, p)
const { primary, secondary } = await getNavScenarios()
const allArticles = await getCollection('articles')
const hasArchived = allArticles.some((a) => a.data.status === 'archived')
---

<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href={lp("/")} aria-label={strings['nav.home_aria']}>
      <img class="brand-logo brand-logo--light" src="/brand/logo-on-light.svg?v=2" alt={strings['brand.name']} width="200" height="52" />
      <img class="brand-logo brand-logo--dark" src="/brand/logo-on-dark.svg?v=2" alt={strings['brand.name']} width="200" height="52" />
      <span class="tagline">{strings['brand.tagline']}</span>
    </a>

    <div class="actions">
      <a class="btn btn-primary subscribe-cta" href={lp("/subscribe/")}>{strings['nav.subscribe']}</a>

      <span class="header-locale">
        <LocaleSwitcher locale={locale} path={currentPath} />
      </span>

      <button
        type="button"
        class="icon-button theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label={strings['theme.to_dark']}
      >
        <span class="theme-icon" aria-hidden="true">◑</span>
      </button>

      <button
        type="button"
        class="icon-button menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="scenario-drawer"
        aria-label={strings['nav.open_menu']}
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <nav class="desktop-nav wrap" aria-label="Scenarios">
    <ul role="list">
      {
        primary.map((scenario) => (
          <li>
            <a href={lp(`/${scenario}/`)}>{scenarioLabel(scenario, locale)}</a>
          </li>
        ))
      }
      {
        secondary.length > 0 && (
          <li class="nav-more" data-nav-more>
            <button
              type="button"
              class="nav-more-toggle"
              aria-expanded="false"
              aria-haspopup="true"
              data-nav-more-toggle
            >
              {strings['nav.more']}
              <span class="nav-more-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-more-menu" data-nav-more-menu hidden>
              <ul role="list">
                {secondary.map((scenario) => (
                  <li>
                    <a href={lp(`/${scenario}/`)}>{scenarioLabel(scenario, locale)}</a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        )
      }
      {hasArchived && (
        <li>
          <a href={lp("/archive/")}>{strings['nav.archive']}</a>
        </li>
      )}
    </ul>
  </nav>

  <!-- Mobile drawer -->
  <div class="drawer-overlay" data-drawer-overlay hidden></div>
  <nav
    id="scenario-drawer"
    class="drawer"
    aria-label="Scenarios"
    data-drawer
    hidden
  >
    <div class="drawer-head">
      <span class="mono">{strings['nav.scenarios']}</span>
      <button
        type="button"
        class="icon-button"
        data-drawer-close
        aria-label={strings['nav.close_menu']}
      >
        <span aria-hidden="true">✕</span>
      </button>
    </div>
    <ul role="list">
      {
        primary.map((scenario) => (
          <li>
            <a href={lp(`/${scenario}/`)}>{scenarioLabel(scenario, locale)}</a>
          </li>
        ))
      }
      {
        secondary.length > 0 && (
          <li class="drawer-divider" aria-hidden="true" />
        )
      }
      {
        secondary.map((scenario) => (
          <li>
            <a href={lp(`/${scenario}/`)}>{scenarioLabel(scenario, locale)}</a>
          </li>
        ))
      }
      {hasArchived && (
        <Fragment>
          <li class="drawer-divider" aria-hidden="true"></li>
          <li>
            <a href={lp("/archive/")}>{strings['nav.archive']}</a>
          </li>
        </Fragment>
      )}
      <li>
        <a class="drawer-subscribe" href={lp("/subscribe/")}>{strings['nav.subscribe']}</a>
      </li>
      <li class="drawer-divider" aria-hidden="true"></li>
      <li class="drawer-locale">
        <LocaleSwitcher locale={locale} path={currentPath} />
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--surface);
    border-block-end: 1px solid var(--hairline);
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .brand {
    text-decoration: none;
    color: var(--main-text);
    display: grid;
    gap: var(--space-3xs);
  }

  .brand-logo {
    display: block;
    block-size: 2.6rem;
    inline-size: auto;
  }

  /* Show the correct lockup for the active theme. */
  .brand-logo--dark {
    display: none;
  }

  :global([data-theme='dark']) .brand-logo--light {
    display: none;
  }

  :global([data-theme='dark']) .brand-logo--dark {
    display: block;
  }

  .tagline {
    font-size: var(--text-label);
    color: var(--muted-text);
    /* Hidden on phones: the full tagline is too long for a narrow top bar and
       collapses into a tall column. Revealed at the desktop breakpoint. */
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .subscribe-cta {
    padding-block: var(--space-xs);
    padding-inline: var(--space-md);
    white-space: nowrap;
    /* Hidden on phones (present in the drawer as a prominent accent button);
       shown inline from the desktop breakpoint. */
    display: none;
  }

  /* The language switch is a single compact word, so it stays visible in the
     top bar at every width (also present in the drawer). Only the bulky tagline
     and subscribe CTA are hidden on phones. */
  .header-locale {
    display: inline-flex;
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    background-color: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 1.1rem;
    color: var(--main-text);
  }

  .menu-toggle {
    display: inline-flex;
  }

  .desktop-nav {
    display: none;
  }

  .desktop-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding-block-end: var(--space-sm);
  }

  .desktop-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted-text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .desktop-nav a:hover {
    color: var(--accent-text);
  }

  /* Desktop "More" dropdown */
  .nav-more {
    position: relative;
  }

  .nav-more-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.02em;
    color: var(--muted-text);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .nav-more-toggle:hover {
    color: var(--accent-text);
  }

  .nav-more-caret {
    font-size: 0.7em;
    transition: transform 120ms ease;
  }

  .nav-more-toggle[aria-expanded='true'] .nav-more-caret {
    transform: rotate(180deg);
  }

  .nav-more-menu {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2xs));
    inset-inline-start: 0;
    z-index: 25;
    min-inline-size: 13rem;
    max-block-size: min(60vh, 26rem);
    overflow-y: auto;
    padding: var(--space-2xs);
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--card-shadow);
  }

  .nav-more-menu ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .nav-more-menu a {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.02em;
    color: var(--main-text);
    text-decoration: none;
    padding-block: var(--space-xs);
    padding-inline: var(--space-sm);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .nav-more-menu a:hover {
    background-color: var(--surface-sunken);
    color: var(--accent-text);
  }

  /* Drawer */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    z-index: 30;
  }

  .drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(20rem, 85vw);
    background-color: var(--surface);
    border-inline-start: 1px solid var(--hairline);
    z-index: 40;
    padding: var(--space-lg);
    overflow-y: auto;
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-lg);
  }

  .drawer-head .mono {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted-text);
  }

  .drawer ul {
    display: grid;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer a {
    display: block;
    padding-block: var(--space-sm);
    padding-inline: var(--space-sm);
    color: var(--main-text);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
  }

  .drawer a:hover {
    border-color: var(--hairline);
  }

  .drawer-divider {
    block-size: 1px;
    background-color: var(--hairline);
    margin-block: var(--space-xs);
  }

  .drawer-subscribe {
    margin-block-start: var(--space-sm);
    background-color: var(--accent-fill);
    color: var(--on-accent-fill) !important;
    text-align: center;
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .desktop-nav {
      display: block;
    }

    .menu-toggle {
      display: none;
    }

    .tagline {
      display: block;
    }

    .subscribe-cta {
      display: inline-flex;
    }
  }
</style>

<script>
  const html = document.documentElement

  // ---- theme toggle ----
  const THEME_KEY = 'gg-theme'

  function applyTheme(theme: 'light' | 'dark') {
    html.setAttribute('data-theme', theme)
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      const isDark = theme === 'dark'
      btn.setAttribute('aria-pressed', String(isDark))
      btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme')
    })
  }

  function currentTheme(): 'light' | 'dark' {
    const stored = localStorage.getItem(THEME_KEY)
    if (stored === 'light' || stored === 'dark') return stored
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }

  applyTheme(currentTheme())

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
      localStorage.setItem(THEME_KEY, next)
      applyTheme(next)
    })
  })

  // ---- mobile drawer with focus trap ----
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')
  const overlay = document.querySelector<HTMLElement>('[data-drawer-overlay]')
  const closeButton = document.querySelector<HTMLButtonElement>('[data-drawer-close]')
  let lastFocused: HTMLElement | null = null

  function focusable(): HTMLElement[] {
    if (!drawer) return []
    return Array.from(
      drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    )
  }

  function openDrawer() {
    if (!drawer || !overlay || !menuToggle) return
    lastFocused = document.activeElement as HTMLElement
    drawer.hidden = false
    overlay.hidden = false
    menuToggle.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
    focusable()[0]?.focus()
    document.addEventListener('keydown', onKeydown)
  }

  function closeDrawer() {
    if (!drawer || !overlay || !menuToggle) return
    drawer.hidden = true
    overlay.hidden = true
    menuToggle.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
    document.removeEventListener('keydown', onKeydown)
    lastFocused?.focus()
  }

  function onKeydown(event: KeyboardEvent) {
    if (event.key === 'Escape') {
      closeDrawer()
      return
    }
    if (event.key === 'Tab') {
      const items = focusable()
      if (items.length === 0) return
      const first = items[0]
      const last = items[items.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }
  }

  menuToggle?.addEventListener('click', openDrawer)
  closeButton?.addEventListener('click', closeDrawer)
  overlay?.addEventListener('click', closeDrawer)

  // ---- desktop "More" scenarios dropdown ----
  const navMore = document.querySelector<HTMLElement>('[data-nav-more]')
  if (navMore) {
    const moreToggle = navMore.querySelector<HTMLButtonElement>('[data-nav-more-toggle]')
    const moreMenu = navMore.querySelector<HTMLElement>('[data-nav-more-menu]')
    if (moreToggle && moreMenu) {
      const openMore = () => {
        moreMenu.hidden = false
        moreToggle.setAttribute('aria-expanded', 'true')
        document.addEventListener('click', onMoreDocClick)
        document.addEventListener('keydown', onMoreKey)
      }
      const closeMore = () => {
        moreMenu.hidden = true
        moreToggle.setAttribute('aria-expanded', 'false')
        document.removeEventListener('click', onMoreDocClick)
        document.removeEventListener('keydown', onMoreKey)
      }
      function onMoreDocClick(e: MouseEvent) {
        if (!navMore!.contains(e.target as Node)) closeMore()
      }
      function onMoreKey(e: KeyboardEvent) {
        if (e.key === 'Escape') {
          closeMore()
          moreToggle!.focus()
        }
      }
      moreToggle.addEventListener('click', (e) => {
        e.stopPropagation()
        if (moreMenu.hidden) openMore()
        else closeMore()
      })
    }
  }
</script>
