---
/**
 * Downloadable branded documents section for article pages.
 *
 * The public site is static, so the document list is fetched at RUNTIME by the
 * client script below from `/api/documents/<slug>` (a server route backed by
 * Supabase, anon-read where status='ready'). Nothing renders if there are no
 * ready documents — the section removes itself.
 *
 * The generated PDFs themselves carry full Galing Gear branding (logo, orange
 * accent, Fraunces + Inter). This on-page section matches the site chrome.
 */
import { type Locale, DEFAULT_LOCALE } from '../lib/i18n'
import { resolvedCatalogue } from '../lib/catalogue'

interface Props {
  slug: string
  locale?: Locale
}

const { slug, locale = DEFAULT_LOCALE } = Astro.props
const strings = resolvedCatalogue(locale)

// Doc-type labels handed to the client script (it cannot import the server-only
// i18n module). Keys mirror the admin DocType union.
const typeLabels: Record<string, string> = {
  checklist: strings['documents.type.checklist'],
  'packing-list': strings['documents.type.packing-list'],
  'emergency-plan': strings['documents.type.emergency-plan'],
  summary: strings['documents.type.summary'],
  recipe: strings['documents.type.recipe'],
  'buying-guide': strings['documents.type.buying-guide'],
}
const clientStrings = {
  download: strings['documents.download'],
  types: typeLabels,
  // Taglish is the default locale; when the reader is on it, prefer the Taglish
  // PDF and fall back to the English base when no Taglish variant exists.
  preferTaglish: locale !== 'en',
}
---

{/* Hidden until the client script confirms there is at least one document. */}
<section class="gg-downloads" data-gg-downloads hidden data-slug={slug}>
  <div class="ggd-head">
    <span class="ggd-kicker mono">{strings['documents.heading']}</span>
  </div>
  <ul class="ggd-list" data-downloads-list role="list"></ul>
  <script type="application/json" data-downloads-i18n set:html={JSON.stringify(clientStrings)} />
</section>

<!-- is:global is REQUIRED: the download list below is injected at runtime via
     list.innerHTML, so Astro's scoped styles (which tag only build-time elements
     with data-astro-cid-*) would never match it. All selectors are prefixed
     .gg-downloads / .ggd-* so there is no leakage. -->
<style is:global>
  /* Compact three-up download cards ("Treatment B"): a mini PDF-page thumbnail
     beside the doc type + title, with a "Download PDF" text link. No
     description, no oversized button — keeps the end of the article tidy and
     scales cleanly when an article has several documents. */
  .gg-downloads {
    padding-block: var(--space-2xl);
  }

  .ggd-head {
    margin-block-end: var(--space-md);
  }

  .ggd-kicker {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }

  .ggd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 56rem) {
    .ggd-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 36rem) {
    .ggd-list {
      grid-template-columns: 1fr;
    }
  }

  .ggd-item {
    display: flex;
    align-items: stretch;
    gap: var(--space-sm);
    border: 1px solid var(--hairline);
    border-block-start: 3px solid var(--accent-fill, #e2620e);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    padding: var(--space-md);
  }

  /* Mini PDF-page thumbnail, drawn with CSS (no image asset needed). */
  .ggd-thumb {
    flex: 0 0 auto;
    inline-size: 2.9rem;
    align-self: flex-start;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    background-color: #fff;
    overflow: hidden;
    box-shadow: 0 1px 2px rgb(15 92 99 / 0.1);
  }

  .ggd-thumb .tbar {
    display: block;
    block-size: 0.8rem;
    background-color: var(--clay-50, #f4f1ea);
    border-block-end: 2px solid var(--accent-fill, #e2620e);
  }

  .ggd-thumb .tl {
    display: block;
    block-size: 0.22rem;
    border-radius: 2px;
    background-color: var(--hairline);
    margin: 0.32rem 0.36rem 0;
  }

  .ggd-thumb .tl.s {
    inline-size: 60%;
  }

  .ggd-mid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    min-inline-size: 0;
    flex: 1 1 auto;
  }

  .ggd-type {
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-text);
  }

  .ggd-title {
    font-family: var(--font-display);
    font-size: var(--text-body, 1rem);
    line-height: 1.25;
    color: var(--main-text);
    margin: 0;
  }

  .ggd-dl {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    color: var(--accent-text);
    font-weight: 600;
    font-size: var(--text-label);
    text-decoration: none;
  }

  .ggd-dl:hover {
    text-decoration: underline;
  }

  .ggd-dl svg {
    inline-size: 0.9rem;
    block-size: 0.9rem;
  }
</style>

<script>
  // Runtime fetch of ready documents for this article. The page is static; this
  // is the only place the document list is resolved. Fails silently — the
  // section stays hidden if there is nothing to show or the request errors.
  const section = document.querySelector<HTMLElement>('[data-gg-downloads]')
  if (section) {
    const slug = section.dataset.slug ?? ''
    const list = section.querySelector<HTMLElement>('[data-downloads-list]')
    const i18nEl = section.querySelector<HTMLElement>('[data-downloads-i18n]')
    let i18n: { download: string; types: Record<string, string>; preferTaglish?: boolean } = { download: 'Download PDF', types: {} }
    try {
      if (i18nEl?.textContent) i18n = JSON.parse(i18nEl.textContent)
    } catch {
      /* keep defaults */
    }

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;'
      )

    const dlIcon =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>'

    if (slug && list) {
      fetch(`/api/documents/${encodeURIComponent(slug)}`, { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((data: { ok?: boolean; documents?: Array<{ id: string; docType: string; title: string; description: string; pdfUrl: string; pdfUrlTl?: string | null }> }) => {
          const docs = Array.isArray(data?.documents) ? data.documents : []
          if (docs.length === 0) return
          list.innerHTML = docs
            .map((d) => {
              const typeLabel = i18n.types[d.docType] ?? d.docType
              // Prefer the Taglish PDF for Taglish readers; fall back to English.
              // Route through the same-origin download proxy so the browser
              // saves the file (a cross-origin <a download> to images.* is
              // ignored and opens inline instead).
              const useTl = i18n.preferTaglish && d.pdfUrlTl
              const href = `/api/documents/download/${encodeURIComponent(d.id)}${useTl ? '?tl=1' : ''}`
              return (
                `<li class="ggd-item">` +
                `<span class="ggd-thumb" aria-hidden="true"><span class="tbar"></span><span class="tl"></span><span class="tl s"></span><span class="tl"></span></span>` +
                `<span class="ggd-mid">` +
                `<span class="ggd-type">${esc(typeLabel)}</span>` +
                `<h3 class="ggd-title">${esc(d.title)}</h3>` +
                `<a class="ggd-dl" href="${esc(href)}" target="_blank" rel="noopener" download>${dlIcon}<span>${esc(i18n.download)}</span></a>` +
                `</span>` +
                `</li>`
              )
            })
            .join('')
          section.hidden = false
        })
        .catch(() => {
          /* leave hidden */
        })
    }
  }
</script>
