---
/**
 * Downloadable branded documents section for article pages.
 *
 * The public site is static, so the document list is fetched at RUNTIME by the
 * client script below from `/api/documents/<slug>` (a server route backed by
 * Supabase, anon-read where status='ready'). Nothing renders if there are no
 * ready documents — the section removes itself.
 *
 * The generated PDFs themselves carry full Galing Gear branding (logo, orange
 * accent, Fraunces + Inter). This on-page section matches the site chrome.
 */
import { type Locale, DEFAULT_LOCALE } from '../lib/i18n'
import { resolvedCatalogue } from '../lib/catalogue'

interface Props {
  slug: string
  locale?: Locale
}

const { slug, locale = DEFAULT_LOCALE } = Astro.props
const strings = resolvedCatalogue(locale)

// Doc-type labels handed to the client script (it cannot import the server-only
// i18n module). Keys mirror the admin DocType union.
const typeLabels: Record<string, string> = {
  checklist: strings['documents.type.checklist'],
  'packing-list': strings['documents.type.packing-list'],
  'emergency-plan': strings['documents.type.emergency-plan'],
  summary: strings['documents.type.summary'],
  recipe: strings['documents.type.recipe'],
  'buying-guide': strings['documents.type.buying-guide'],
}
const clientStrings = {
  download: strings['documents.download'],
  types: typeLabels,
}
---

{/* Hidden until the client script confirms there is at least one document. */}
<section class="gg-downloads" data-gg-downloads hidden data-slug={slug}>
  <div class="wrap">
    <div class="ggd-card">
      <div class="ggd-head">
        <span class="ggd-kicker mono">{strings['documents.heading']}</span>
        <p class="ggd-sub">{strings['documents.subheading']}</p>
      </div>
      <ul class="ggd-list" data-downloads-list role="list"></ul>
    </div>
  </div>
  <script type="application/json" data-downloads-i18n set:html={JSON.stringify(clientStrings)} />
</section>

<style>
  .gg-downloads {
    padding-block: var(--space-2xl);
  }

  .ggd-card {
    border: 1px solid var(--hairline);
    border-block-start: 3px solid var(--accent-fill, #e2620e);
    border-radius: var(--radius-lg, 14px);
    background-color: var(--surface);
    padding: var(--space-xl);
  }

  .ggd-kicker {
    display: inline-block;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
  }

  .ggd-sub {
    margin-block-start: var(--space-xs);
    color: var(--muted-text);
    max-inline-size: 60ch;
  }

  .ggd-list {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .ggd-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background-color: var(--surface-sunken, #f4f1ea);
    padding: var(--space-lg);
  }

  .ggd-type {
    align-self: flex-start;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-text);
    background-color: color-mix(in srgb, var(--accent-fill, #e2620e) 12%, transparent);
    border-radius: var(--radius-pill);
    padding: var(--space-3xs) var(--space-sm);
  }

  .ggd-title {
    font-family: var(--font-display);
    font-size: var(--text-h3, 1.25rem);
    line-height: 1.3;
    color: var(--main-text);
    margin: 0;
  }

  .ggd-desc {
    color: var(--muted-text);
    font-size: var(--text-label);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .ggd-dl {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--accent-fill, #e2620e);
    color: #fff;
    font-weight: 600;
    font-size: var(--text-label);
    text-decoration: none;
    transition: filter 0.15s ease;
  }

  .ggd-dl:hover {
    filter: brightness(0.94);
  }

  .ggd-dl svg {
    inline-size: 1rem;
    block-size: 1rem;
  }
</style>

<script>
  // Runtime fetch of ready documents for this article. The page is static; this
  // is the only place the document list is resolved. Fails silently — the
  // section stays hidden if there is nothing to show or the request errors.
  const section = document.querySelector<HTMLElement>('[data-gg-downloads]')
  if (section) {
    const slug = section.dataset.slug ?? ''
    const list = section.querySelector<HTMLElement>('[data-downloads-list]')
    const i18nEl = section.querySelector<HTMLElement>('[data-downloads-i18n]')
    let i18n: { download: string; types: Record<string, string> } = { download: 'Download PDF', types: {} }
    try {
      if (i18nEl?.textContent) i18n = JSON.parse(i18nEl.textContent)
    } catch {
      /* keep defaults */
    }

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;'
      )

    const dlIcon =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>'

    if (slug && list) {
      fetch(`/api/documents/${encodeURIComponent(slug)}`, { headers: { accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((data: { ok?: boolean; documents?: Array<{ id: string; docType: string; title: string; description: string; pdfUrl: string }> }) => {
          const docs = Array.isArray(data?.documents) ? data.documents : []
          if (docs.length === 0) return
          list.innerHTML = docs
            .map((d) => {
              const typeLabel = i18n.types[d.docType] ?? d.docType
              const desc = d.description ? `<p class="ggd-desc">${esc(d.description)}</p>` : ''
              return (
                `<li class="ggd-item">` +
                `<span class="ggd-type">${esc(typeLabel)}</span>` +
                `<h3 class="ggd-title">${esc(d.title)}</h3>` +
                desc +
                `<a class="ggd-dl" href="${esc(d.pdfUrl)}" target="_blank" rel="noopener" download>${dlIcon}<span>${esc(i18n.download)}</span></a>` +
                `</li>`
              )
            })
            .join('')
          section.hidden = false
        })
        .catch(() => {
          /* leave hidden */
        })
    }
  }
</script>
